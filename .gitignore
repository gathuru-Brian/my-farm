**/vendor/
/frontend_backup_*/
**/public/build/
**/public/hot
**/public/storage
**/.phpunit.result.cache
**/storage/logs/*.log
**/bootstrap/cache/*.php

# Local editor and agent configuration
/.vscode/
**/.mcp.json
**/.codex/
**/.claude/
