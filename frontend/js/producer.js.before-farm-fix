/*
 * Modern Farms
 * Producer Dashboard
 * frontend/js/producer.js
 */

(function () {
    "use strict";

    let currentUser = null;
    let products = [];
    let inventory = {};

    const API = window.ModernFarmsAPI;

    if (!API) {
        console.error("ModernFarmsAPI is not loaded.");
        return;
    }

    document.addEventListener("DOMContentLoaded", init);

    async function init() {
        try {
            await loadUser();
            await loadDashboard();
            bindEvents();
        } catch (error) {
            console.error("Producer dashboard initialization failed:", error);
            showMessage(
                error.message || "Unable to load producer dashboard.",
                "error"
            );
        }
    }

    // =========================================================
    // USER
    // =========================================================

    async function loadUser() {
        currentUser = API.getCurrentUser();

        if (!currentUser) {
            try {
                const response = await API.me();

                currentUser =
                    response.user ||
                    response.account ||
                    response.data?.user ||
                    response.data ||
                    null;

                if (currentUser) {
                    API.setCurrentUser(currentUser);
                }
            } catch (error) {
                console.warn("Unable to retrieve authenticated user:", error);
            }
        }

        if (!currentUser) {
            throw new Error("Please sign in again.");
        }

        updateUserInterface();
    }

    function updateUserInterface() {
        const nameElements = document.querySelectorAll(
            "[data-user-name], #producerName, #userName"
        );

        nameElements.forEach(element => {
            element.textContent =
                currentUser.full_name ||
                currentUser.name ||
                currentUser.email ||
                "Producer";
        });

        const emailElements = document.querySelectorAll(
            "[data-user-email], #producerEmail, #userEmail"
        );

        emailElements.forEach(element => {
            element.textContent = currentUser.email || "";
        });
    }

    // =========================================================
    // DASHBOARD
    // =========================================================

    async function loadDashboard() {
        await Promise.all([
            loadInventory(),
            loadProducts()
        ]);

        await loadOrders();
    }

    // =========================================================
    // PRODUCTS
    // =========================================================

    async function loadProducts() {
        try {
            const response = await API.getMyProducts();

            products = response.products || [];

            renderProducts(
                document.getElementById("productsList"),
                products
            );

            updateProductCount(products.length);
        } catch (error) {
            console.error("Failed to load products:", error);

            const container = document.getElementById("productsList");

            if (container) {
                container.innerHTML = `
                    <div class="dashboard-empty error-state">
                        Unable to load products.
                    </div>
                `;
            }
        }
    }

    // =========================================================
    // INVENTORY
    // =========================================================

    async function loadInventory() {
        try {
            const summary = await API.getInventory();

            inventory = summary.inventory || {};

            updateInventoryStatistics(inventory);

            const inventoryContainer =
                document.getElementById("inventoryList");

            if (inventoryContainer) {
                renderProducts(inventoryContainer, products);
            }
        } catch (error) {
            console.error("Failed to load inventory:", error);
        }
    }

    function updateInventoryStatistics(data) {
        setText(
            "productCount",
            data.total_products ?? products.length
        );

        setText(
            "totalProducts",
            data.total_products ?? products.length
        );

        setText(
            "quantityPosted",
            formatNumber(data.total_quantity_posted)
        );

        setText(
            "quantitySold",
            formatNumber(data.total_quantity_sold)
        );

        setText(
            "quantityRemaining",
            formatNumber(data.total_quantity_remaining)
        );

        setText(
            "totalQuantityPosted",
            formatNumber(data.total_quantity_posted)
        );

        setText(
            "totalQuantitySold",
            formatNumber(data.total_quantity_sold)
        );

        setText(
            "totalQuantityRemaining",
            formatNumber(data.total_quantity_remaining)
        );
    }

    // =========================================================
    // RENDER PRODUCTS
    // =========================================================

    function renderProducts(container, productList) {
        if (!container) {
            return;
        }

        if (!productList || productList.length === 0) {
            container.innerHTML = `
                <div class="dashboard-empty">
                    <div class="empty-icon">🌱</div>
                    <h3>No products yet</h3>
                    <p>Add your first product to start selling.</p>
                </div>
            `;

            return;
        }

        container.innerHTML = productList.map(product => {
            const remaining = Number(
                product.quantity_remaining || 0
            );

            const sold = Number(
                product.quantity_sold || 0
            );

            const status = product.status || "available";

            return `
                <div class="product-card"
                     data-product-id="${product.id}">

                    <div class="product-card-header">

                        <div>
                            <h3>
                                ${API.escapeHTML(product.name)}
                            </h3>

                            <span class="product-category">
                                ${API.escapeHTML(
                                    product.category || "General"
                                )}
                            </span>
                        </div>

                        <span class="product-status ${status}">
                            ${API.escapeHTML(status)}
                        </span>

                    </div>

                    <div class="product-description">
                        ${API.escapeHTML(
                            product.description ||
                            "No description available."
                        )}
                    </div>

                    <div class="product-details">

                        <div>
                            <span>Price</span>
                            <strong>
                                ${API.formatCurrency(product.price)}
                            </strong>
                            <small>
                                / ${API.escapeHTML(product.unit || "unit")}
                            </small>
                        </div>

                        <div>
                            <span>Available</span>
                            <strong>
                                ${formatNumber(remaining)}
                            </strong>
                            <small>
                                ${API.escapeHTML(product.unit || "units")}
                            </small>
                        </div>

                        <div>
                            <span>Sold</span>
                            <strong>
                                ${formatNumber(sold)}
                            </strong>
                        </div>

                    </div>

                    <div class="product-actions">

                        <button
                            type="button"
                            class="btn btn-secondary"
                            onclick="ModernFarmsProducer.editProduct(${product.id})">
                            Edit
                        </button>

                        <button
                            type="button"
                            class="btn btn-danger"
                            onclick="ModernFarmsProducer.deleteProduct(${product.id})">
                            Deactivate
                        </button>

                    </div>

                </div>
            `;
        }).join("");
    }

    // =========================================================
    // ADD PRODUCT
    // =========================================================

    async function addProduct(event) {
        if (event) {
            event.preventDefault();
        }

        const name = getValue("productName");
        const category = getValue("productCategory");
        const description = getValue("productDescription");
        const price = Number(getValue("productPrice"));
        const unit = getValue("productUnit");
        const quantity = Number(getValue("productQuantity"));

        if (!name) {
            showMessage("Product name is required.", "error");
            return;
        }

        if (!category) {
            showMessage("Please select a product category.", "error");
            return;
        }

        if (!price || price <= 0) {
            showMessage("Enter a valid product price.", "error");
            return;
        }

        if (!unit) {
            showMessage("Please select a unit.", "error");
            return;
        }

        if (!quantity || quantity <= 0) {
            showMessage("Enter a valid quantity.", "error");
            return;
        }

        /*
         * Farm 1 is currently Modern Farms Main Farm.
         *
         * We will replace this with dynamic producer-farm
         * selection when the farm management UI is connected.
         */
        const farmId = Number(
            getValue("productFarm") ||
            window.MODERN_FARMS_FARM_ID ||
            1
        );

        const payload = {
            farm_id: farmId,
            name,
            category,
            description,
            price,
            unit,
            quantity_posted: quantity
        };

        try {
            setFormLoading(true);

            const response = await API.createProduct(payload);

            showMessage(
                response.message ||
                "Product added successfully.",
                "success"
            );

            resetProductForm();

            await loadProducts();
            await loadInventory();

            closeProductModal();

        } catch (error) {
            console.error("Product creation failed:", error);

            showMessage(
                error.data?.message ||
                error.message ||
                "Unable to create product.",
                "error"
            );

        } finally {
            setFormLoading(false);
        }
    }

    // =========================================================
    // EDIT PRODUCT
    // =========================================================

    async function editProduct(productId) {
        const product = products.find(
            item => Number(item.id) === Number(productId)
        );

        if (!product) {
            showMessage("Product could not be found.", "error");
            return;
        }

        const name = window.prompt(
            "Product name:",
            product.name || ""
        );

        if (name === null) {
            return;
        }

        const priceInput = window.prompt(
            "Price:",
            product.price || ""
        );

        if (priceInput === null) {
            return;
        }

        const quantityInput = window.prompt(
            "Quantity to add:",
            "0"
        );

        if (quantityInput === null) {
            return;
        }

        const price = Number(priceInput);
        const quantity = Number(quantityInput);

        if (!name.trim()) {
            showMessage("Product name cannot be empty.", "error");
            return;
        }

        if (!Number.isFinite(price) || price <= 0) {
            showMessage("Enter a valid price.", "error");
            return;
        }

        if (!Number.isFinite(quantity) || quantity < 0) {
            showMessage("Enter a valid quantity.", "error");
            return;
        }

        try {
            const response = await API.updateProduct(
                productId,
                {
                    name: name.trim(),
                    price,
                    quantity_posted: quantity
                }
            );

            showMessage(
                response.message ||
                "Product updated successfully.",
                "success"
            );

            await loadProducts();
            await loadInventory();

        } catch (error) {
            console.error("Product update failed:", error);

            showMessage(
                error.data?.message ||
                error.message ||
                "Unable to update product.",
                "error"
            );
        }
    }

    // =========================================================
    // DELETE / DEACTIVATE PRODUCT
    // =========================================================

    async function deleteProduct(productId) {
        const product = products.find(
            item => Number(item.id) === Number(productId)
        );

        if (!product) {
            showMessage("Product could not be found.", "error");
            return;
        }

        const confirmed = window.confirm(
            `Deactivate "${product.name}"?`
        );

        if (!confirmed) {
            return;
        }

        try {
            const response = await API.deleteProduct(productId);

            showMessage(
                response.message ||
                "Product deactivated successfully.",
                "success"
            );

            await loadProducts();
            await loadInventory();

        } catch (error) {
            console.error("Product deactivation failed:", error);

            showMessage(
                error.data?.message ||
                error.message ||
                "Unable to deactivate product.",
                "error"
            );
        }
    }

    // =========================================================
    // ORDERS
    // =========================================================

    async function loadOrders() {
        try {
            if (typeof API.getProducerOrders !== "function") {
                return;
            }

            const response = await API.getProducerOrders();

            const orders =
                response.orders ||
                response.data ||
                [];

            renderOrders(orders);

        } catch (error) {
            console.warn(
                "Producer orders could not be loaded:",
                error
            );
        }
    }

    function renderOrders(orders) {
        const container =
            document.getElementById("ordersList");

        if (!container) {
            return;
        }

        if (!orders.length) {
            container.innerHTML = `
                <div class="dashboard-empty">
                    No orders available.
                </div>
            `;

            return;
        }

        container.innerHTML = orders.map(order => `
            <div class="order-card">

                <strong>
                    Order #${API.escapeHTML(order.id)}
                </strong>

                <span>
                    ${API.escapeHTML(
                        order.status || "pending"
                    )}
                </span>

            </div>
        `).join("");
    }

    // =========================================================
    // EVENTS
    // =========================================================

    function bindEvents() {
        const form = document.getElementById("productForm");

        if (form) {
            form.addEventListener("submit", addProduct);
        }

        const addButtons = document.querySelectorAll(
            "[data-action='add-product'], #addProductButton"
        );

        addButtons.forEach(button => {
            button.addEventListener(
                "click",
                openProductModal
            );
        });

        const closeButtons = document.querySelectorAll(
            "[data-action='close-product-modal'], #closeProductModal"
        );

        closeButtons.forEach(button => {
            button.addEventListener(
                "click",
                closeProductModal
            );
        });
    }

    // =========================================================
    // MODAL
    // =========================================================

    function openProductModal() {
        const modal =
            document.getElementById("productModal");

        if (modal) {
            modal.classList.add("active");
            modal.style.display = "flex";
        }
    }

    function closeProductModal() {
        const modal =
            document.getElementById("productModal");

        if (modal) {
            modal.classList.remove("active");
            modal.style.display = "none";
        }
    }

    function resetProductForm() {
        const form =
            document.getElementById("productForm");

        if (form) {
            form.reset();
        }
    }

    // =========================================================
    // UTILITIES
    // =========================================================

    function getValue(id) {
        const element = document.getElementById(id);

        return element
            ? element.value.trim()
            : "";
    }

    function setText(id, value) {
        const element = document.getElementById(id);

        if (element) {
            element.textContent = value;
        }
    }

    function formatNumber(value) {
        return Number(value || 0).toLocaleString("en-KE");
    }

    function updateProductCount(count) {
        setText("productCount", count);
        setText("totalProducts", count);
    }

    function setFormLoading(loading) {
        const form =
            document.getElementById("productForm");

        if (!form) {
            return;
        }

        const button =
            form.querySelector(
                "button[type='submit']"
            );

        if (!button) {
            return;
        }

        button.disabled = loading;

        button.textContent = loading
            ? "Adding..."
            : "Add Product";
    }

    function showMessage(message, type = "info") {
        let container =
            document.getElementById("dashboardMessage");

        if (!container) {
            container = document.createElement("div");

            container.id = "dashboardMessage";

            document.body.prepend(container);
        }

        container.className =
            `dashboard-message ${type}`;

        container.textContent = message;

        setTimeout(() => {
            if (container) {
                container.classList.add("hidden");
            }
        }, 5000);
    }

    // =========================================================
    // PUBLIC API
    // =========================================================

    window.ModernFarmsProducer = {
        loadDashboard,
        loadProducts,
        loadInventory,
        addProduct,
        editProduct,
        deleteProduct,
        openProductModal,
        closeProductModal
    };

})();

