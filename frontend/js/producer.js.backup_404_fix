    /* =====================================================
       RECENT ORDERS
    ===================================================== */

    function renderRecentOrders() {

        const container =
            document.getElementById(
                "recentOrders"
            );


        if (!container) {
            return;
        }


        if (!orders.length) {

            container.innerHTML = `

                <div class="empty-state">

                    <div class="empty-icon">
                        🛒
                    </div>

                    <h3>
                        No orders yet
                    </h3>

                    <p>
                        You don't have any orders
                        at the moment.
                    </p>

                </div>

            `;

            return;

        }


        const recent =
            orders.slice(0, 3);


        container.innerHTML =
            recent.map(
                order =>
                    createRecentOrder(
                        order
                    )
            ).join("");

    }


    function createRecentOrder(order) {

        const id =
            Number(order.id) || 0;


        const status =
            normalizeStatus(
                order.status ||
                "pending"
            );


        const quantity =
            Number(
                order.quantity ||
                order.quantity_ordered ||
                1
            );


        return `

            <div
                style="
                    width:100%;
                    padding:12px 16px;
                    border-bottom:1px solid #edf1ee;
                "
            >

                <strong>
                    Order #${id}
                </strong>

                <div
                    style="
                        display:flex;
                        justify-content:space-between;
                        margin-top:7px;
                        color:#6d7d75;
                        font-size:11px;
                    "
                >

                    <span>
                        ${quantity} units
                    </span>

                    <span class="order-status">
                        ${capitalize(status)}
                    </span>

                </div>

            </div>

        `;

    }


    /* =====================================================
       ORDERS PAGE
    ===================================================== */

