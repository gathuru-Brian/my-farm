/*
 * =========================================================
 * MODERN FARMS
 * PRODUCER DASHBOARD CONTROLLER
 * frontend/js/producer.js
 * =========================================================
 */

(function () {

    "use strict";


    let currentUser = null;

    let currentFarm = null;

    let products = [];

    let orders = [];


    const API = window.ModernFarmsAPI;


    /* =====================================================
       INITIALIZATION
    ===================================================== */

    document.addEventListener(
        "DOMContentLoaded",
        initProducerDashboard
    );


    async function initProducerDashboard() {

        try {

            if (!API) {

                throw new Error(
                    "Modern Farms API client is not loaded."
                );

            }


            if (!API.isAuthenticated()) {

                window.location.replace(
                    "/frontend/pages/login.html"
                );

                return;

            }


            await loadUser();


            await Promise.all([
                loadFarm(),
                loadProducts(),
                loadOrders()
            ]);


            renderDashboard();


            startAutoRefresh();


        } catch (error) {

            console.error(
                "Producer dashboard initialization failed:",
                error
            );

            showError(
                error.message ||
                "Unable to load producer dashboard."
            );

        }

    }


    /* =====================================================
       USER
    ===================================================== */

    async function loadUser() {

        const response =
            await API.me();


        currentUser =
            response?.user ||
            response?.data?.user ||
            API.getCurrentUser();


        if (!currentUser) {

            throw new Error(
                "Unable to load producer account."
            );

        }


        const role =
            String(
                currentUser.role || ""
            )
                .toLowerCase()
                .trim();


        if (role !== "producer") {

            if (role === "customer") {

                window.location.replace(
                    "/frontend/pages/customer-dashboard.html"
                );

                return;

            }


            throw new Error(
                "This dashboard is only available to producers."
            );

        }


        setText(
            "producerName",
            currentUser.full_name ||
            currentUser.name ||
            "Producer"
        );


        setText(
            "profileName",
            currentUser.full_name ||
            "Producer"
        );


        setText(
            "profileFullName",
            currentUser.full_name ||
            "-"
        );


        setText(
            "profileEmail",
            currentUser.email ||
            "-"
        );


        setText(
            "profilePhone",
            currentUser.phone ||
            "Not provided"
        );


        const initials =
            getInitials(
                currentUser.full_name ||
                currentUser.email ||
                "PR"
            );


        setText(
            "accountInitials",
            initials
        );


        setText(
            "profileInitials",
            initials
        );


        setText(
            "accountStatus",
            currentUser.status ||
            "Active"
        );

    }


    /* =====================================================
       FARM
    ===================================================== */

    async function loadFarm() {

        try {

            const response =
                await API.getFarms();


            const farms =
                response?.farms ||
                response?.data ||
                [];


            if (!Array.isArray(farms) || !farms.length) {

                return;

            }


            currentFarm =
                farms.find(
                    farm =>
                        Number(farm.producer_id) ===
                        Number(currentUser.id)
                ) ||
                farms[0];


            renderFarm();

        } catch (error) {

            console.warn(
                "Farm information could not be loaded:",
                error
            );

        }

    }


    function renderFarm() {

        if (!currentFarm) {
            return;
        }


        const name =
            currentFarm.farm_name ||
            "Your Farm";


        const location =
            [
                currentFarm.location,
                currentFarm.county
            ]
                .filter(Boolean)
                .join(", ") ||
            "Kenya";


        const size =
            Number(
                currentFarm.farm_size || 0
            );


        const unit =
            currentFarm.farm_size_unit ||
            "acres";


        setText(
            "sidebarFarmName",
            name
        );


        setText(
            "sidebarFarmLocation",
            location
        );


        setText(
            "sidebarFarmSize",
            `${formatNumber(size)} ${unit}`
        );


        setText(
            "farmName",
            name
        );


        setText(
            "farmLocation",
            location
        );


        setText(
            "farmSize",
            `${formatNumber(size)} ${unit}`
        );


        setText(
            "farmPhone",
            currentFarm.phone ||
            currentUser.phone ||
            "Not provided"
        );

    }


    /* =====================================================
       PRODUCTS
    ===================================================== */

    async function loadProducts() {

        try {

            const response =
                await API.getMyProducts();


            products =
                response?.products ||
                response?.inventory ||
                response?.data ||
                [];


            if (!Array.isArray(products)) {

                products = [];

            }


            renderDashboard();


        } catch (firstError) {

            console.warn(
                "getMyProducts failed. Trying inventory:",
                firstError
            );


            try {

                const response =
                    await API.getInventory();


                products =
                    response?.inventory ||
                    response?.products ||
                    response?.data ||
                    [];


                if (!Array.isArray(products)) {

                    products = [];

                }


                renderDashboard();

            } catch (secondError) {

                console.error(
                    "Products could not be loaded:",
                    secondError
                );

                products = [];

                showError(
                    "Unable to load your products."
                );

            }

        }

    }


    /* =====================================================
       ORDERS
    ===================================================== */

    async function loadOrders() {

        try {

            const response =
                await API.getProducerOrders();


            orders =
                response?.orders ||
                response?.data ||
                [];


            if (!Array.isArray(orders)) {

                orders = [];

            }


            renderDashboard();

        } catch (error) {

            console.warn(
                "Producer orders could not be loaded:",
                error
            );

            orders = [];

            renderDashboard();

        }

    }


    /* =====================================================
       DASHBOARD
    ===================================================== */

    function renderDashboard() {

        renderStatistics();

        renderInventoryOverview();

        renderRecentOrders();

        renderProductsTable();

        renderManagementProducts();

        renderOrdersPage();

        renderAnalytics();

        renderMonthlySummary();

        renderCustomers();

    }


    function getActiveProducts() {

        return products.filter(
            product =>
                String(
                    product.status ||
                    "available"
                )
                    .toLowerCase() !==
                "inactive"
        );

    }


    function renderStatistics() {

        const activeProducts =
            getActiveProducts();


        const totalInventory =
            products.reduce(
                (sum, product) =>
                    sum +
                    Number(
                        product.quantity_remaining ??
                        product.quantity ??
                        product.stock ??
                        0
                    ),
                0
            );


        const totalSold =
            products.reduce(
                (sum, product) =>
                    sum +
                    Number(
                        product.quantity_sold ||
                        0
                    ),
                0
            );


        const pending =
            orders.filter(
                order =>
                    normalizeStatus(
                        order.status
                    ) === "pending"
            ).length;


        const revenue =
            calculateRevenue();


        setText(
            "totalProducts",
            activeProducts.length
        );


        setText(
            "totalInventory",
            formatNumber(totalInventory)
        );


        setText(
            "totalOrders",
            orders.length
        );


        setText(
            "pendingOrders",
            pending
        );


        setText(
            "totalRevenue",
            formatCurrency(revenue)
        );


        setText(
            "inventoryUnitLabel",
            getInventoryUnitLabel()
        );


        const badge =
            document.getElementById(
                "sidebarOrderBadge"
            );


        if (badge) {

            badge.textContent =
                pending;


            badge.hidden =
                pending === 0;

        }


        const notificationBadge =
            document.getElementById(
                "notificationBadge"
            );


        if (notificationBadge) {

            notificationBadge.textContent =
                pending;


            notificationBadge.hidden =
                pending === 0;

        }

    }


    /* =====================================================
       INVENTORY OVERVIEW
    ===================================================== */

    function renderInventoryOverview() {

        const available =
            products.reduce(
                (sum, product) =>
                    sum +
                    Number(
                        product.quantity_remaining ??
                        product.quantity ??
                        product.stock ??
                        0
                    ),
                0
            );


        const sold =
            products.reduce(
                (sum, product) =>
                    sum +
                    Number(
                        product.quantity_sold ||
                        0
                    ),
                0
            );


        const posted =
            products.reduce(
                (sum, product) =>
                    sum +
                    Number(
                        product.quantity_posted ||
                        0
                    ),
                0
            );


        const percent =
            posted > 0
                ? Math.round(
                    (available / posted) * 100
                )
                : 100;


        const lowStock =
            products.filter(
                product =>
                    Number(
                        product.quantity_remaining ??
                        product.quantity ??
                        0
                    ) <= 10
            ).length;


        setText(
            "inventoryPercent",
            `${Math.max(
                0,
                Math.min(100, percent)
            )}%`
        );


        setText(
            "availableInventory",
            formatNumber(available)
        );


        setText(
            "stockInventory",
            formatNumber(available)
        );


        setText(
            "soldInventory",
            formatNumber(sold)
        );


        setText(
            "lowStockProducts",
            lowStock
        );


        const availableUnit =
            document.getElementById(
                "availableUnit"
            );


        if (availableUnit) {

            availableUnit.textContent =
                getPrimaryUnit();

        }


        const donut =
            document.querySelector(
                ".donut"
            );


        if (donut) {

            const degrees =
                Math.max(
                    0,
                    Math.min(
                        360,
                        percent * 3.6
                    )
                );


            donut.style.background =
                `conic-gradient(
                    #68be42 0deg,
                    #68be42 ${degrees}deg,
                    #e8f1e9 ${degrees}deg,
                    #e8f1e9 360deg
                )`;

        }

    }


    /* =====================================================
       PRODUCTS TABLE
    ===================================================== */

    function renderProductsTable() {

        const container =
            document.getElementById(
                "productsTableBody"
            );


        if (!container) {
            return;
        }


        if (!products.length) {

            container.innerHTML = `
                <tr>
                    <td
                        colspan="7"
                        class="table-loading"
                    >
                        No products have been added yet.
                    </td>
                </tr>
            `;

            setText(
                "productsFooter",
                "Showing 0 products"
            );

            return;

        }


        container.innerHTML =
            products
                .map(
                    product =>
                        createProductRow(
                            product
                        )
                )
                .join("");


        setText(
            "productsFooter",
            `Showing 1 to ${products.length} of ${products.length} products`
        );

    }


    function createProductRow(product) {

        const id =
            Number(product.id) || 0;


        const name =
            product.name ||
            product.product_name ||
            "Product";


        const category =
            product.category ||
            "General";


        const price =
            Number(product.price || 0);


        const available =
            Number(
                product.quantity_remaining ??
                product.quantity ??
                product.stock ??
                0
            );


        const sold =
            Number(
                product.quantity_sold ||
                0
            );


        const unit =
            product.unit ||
            "unit";


        const status =
            product.status ||
            "available";


        return `

            <tr>

                <td>

                    <div class="product-name">

                        <div class="product-thumb">
                            ${getProductIcon(category)}
                        </div>

                        <div>

                            <strong>
                                ${escapeHtml(name)}
                            </strong>

                            <small>
                                ${escapeHtml(
                                    product.description ||
                                    "Farm product"
                                )}
                            </small>

                        </div>

                    </div>

                </td>


                <td>

                    <span class="category-pill">
                        ${escapeHtml(category)}
                    </span>

                </td>


                <td>

                    <strong>
                        ${formatCurrency(price)}
                    </strong>

                    <small>
                        / ${escapeHtml(unit)}
                    </small>

                </td>


                <td>
                    <strong>
                        ${formatNumber(available)}
                    </strong>
                    <small>
                        ${escapeHtml(unit)}
                    </small>
                </td>


                <td>

                    <strong>
                        ${formatNumber(sold)}
                    </strong>

                    <small>
                        ${escapeHtml(unit)}
                    </small>

                </td>


                <td>

                    <span class="status-pill">
                        ${escapeHtml(
                            capitalize(status)
                        )}
                    </span>

                </td>


                <td>

                    <div class="action-buttons">

                        <button
                            class="icon-button edit"
                            title="Edit"
                            onclick="editProduct(${id})"
                        >
                            ✎
                        </button>

                        <button
                            class="icon-button copy"
                            title="Duplicate"
                            onclick="duplicateProduct(${id})"
                        >
                            ⧉
                        </button>

                        <button
                            class="icon-button delete"
                            title="Deactivate"
                            onclick="deleteProduct(${id})"
                        >
                            🗑
                        </button>

                    </div>

                </td>

            </tr>

        `;

    }


