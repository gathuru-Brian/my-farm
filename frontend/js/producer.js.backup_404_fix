                            product.quantity ??
                            0
                        );


                    return `

                        <article
                            class="management-product"
                        >

                            <div
                                class="product-thumb"
                            >
                                ${getProductIcon(
                                    product.category
                                )}
                            </div>

                            <h3>
                                ${escapeHtml(
                                    product.name ||
                                    "Product"
                                )}
                            </h3>

                            <span
                                class="category-pill"
                            >
                                ${escapeHtml(
                                    product.category ||
                                    "General"
                                )}
                            </span>

                            <p>
                                ${escapeHtml(
                                    product.description ||
                                    "No description."
                                )}
                            </p>

                            <div
                                class="management-meta"
                            >

                                <div>
                                    <span>Price</span>
