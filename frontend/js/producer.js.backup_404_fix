    /* =====================================================
       ANALYTICS
    ===================================================== */

    function renderAnalytics() {

        const inventoryValue =
            products.reduce(
                (sum, product) =>
                    sum +
                    (
                        Number(
                            product.price || 0
                        ) *
                        Number(
                            product.quantity_remaining ??
                            product.quantity ??
                            0
                        )
                    ),
                0
            );


        const sold =
            products.reduce(
                (sum, product) =>
                    sum +
                    Number(
                        product.quantity_sold ||
                        0
                    ),
                0
            );


        const revenue =
            calculateRevenue();


        setText(
            "analyticsInventoryValue",
            formatCurrency(
                inventoryValue
            )
        );


        setText(
            "analyticsSold",
            formatNumber(sold)
        );


        setText(
            "analyticsProducts",
            getActiveProducts().length
        );


        setText(
            "analyticsRevenue",
            formatCurrency(revenue)
        );


        setText(
            "inventoryValue",
            formatCurrency(
                inventoryValue
            )
        );


        setBar(
            "inventoryBar",
            products.length
                ? 100
                : 0
        );


        setBar(
            "soldBar",
            sold > 0
                ? Math.min(100, sold * 5)
                : 0
        );


        setBar(
            "ordersBar",
            orders.length > 0
                ? Math.min(
                    100,
                    orders.length * 10
                )
                : 0
        );

    }


    /* =====================================================
       MONTHLY SUMMARY
    ===================================================== */

    function renderMonthlySummary() {

        const now =
            new Date();


        const month =
            now.getMonth();


        const year =
            now.getFullYear();


        const monthProducts =
            products.filter(
                product => {

                    const date =
                        parseDate(
                            product.created_at
                        );

                    return (
                        date &&
                        date.getMonth() === month &&
                        date.getFullYear() === year
                    );

                }
            ).length;


        const monthOrders =
            orders.filter(
                order => {

                    const date =
                        parseDate(
                            order.created_at ||
                            order.order_date ||
                            order.date
                        );

                    return (
                        date &&
                        date.getMonth() === month &&
                        date.getFullYear() === year
                    );

                }
            ).length;


        setText(
            "monthProducts",
            monthProducts
        );


        setText(
            "monthOrders",
            monthOrders
        );


        setText(
            "monthRevenue",
            formatCurrency(
                calculateRevenue()
            )
        );

    }


    /* =====================================================
       CUSTOMERS
    ===================================================== */

    function renderCustomers() {

        const container =
            document.getElementById(
                "customersContent"
            );


        if (!container) {
            return;
        }


        const customers =
            new Set();


        orders.forEach(
            order => {

                const email =
                    order.customer_email ||
                    order.customer?.email ||
                    order.email;


                if (email) {
                    customers.add(email);
                }

            }
        );


        if (!customers.size) {
            return;
        }


        container.innerHTML = `

            <div style="padding:25px">

                <h3>
                    ${customers.size}
                    Customer${customers.size === 1 ? "" : "s"}
                </h3>

                <p style="color:#6d7d75">
                    Customers who have interacted
                    with your farm through orders.
                </p>

            </div>

        `;

    }


    /* =====================================================
       ADD PRODUCT
    ===================================================== */

    async function addProduct(event) {

        event.preventDefault();


        const name =
            getValue(
                "productName"
            );


        const category =
            getValue(
                "productCategory"
            );


        const price =
            Number(
                getValue(
                    "productPrice"
                )
            );


        const unit =
            getValue(
                "productUnit"
            );


        const quantity =
            Number(
                getValue(
                    "productQuantity"
                )
            );


        const description =
            getValue(
                "productDescription"
            );


        if (!name) {

            showError(
                "Enter a product name."
            );

            return;

        }


        if (!category) {

            showError(
                "Select a product category."
            );

            return;

        }


        if (!Number.isFinite(price) || price <= 0) {

            showError(
                "Enter a valid product price."
            );

            return;

        }


        if (!Number.isFinite(quantity) || quantity <= 0) {

            showError(
                "Enter a valid product quantity."
            );

            return;

        }


        if (!currentFarm?.id) {

            showError(
                "Your producer farm could not be identified."
            );

            return;

        }


        const payload = {

            farm_id:
                Number(
                    currentFarm.id
                ),

            name,

            category,

            description,

            price,

            unit,

            quantity_posted:
                quantity

        };


        try {

            setFormLoading(true);


            await API.createProduct(
                payload
            );


            showSuccess(
                "Product added successfully."
            );


            closeProductModal();


            document
                .getElementById(
                    "addProductForm"
                )
                ?.reset();


            await loadProducts();


        } catch (error) {

            console.error(
                "Add product error:",
                error
            );


            showError(
                error.message ||
                "Unable to add product."
            );

        } finally {

            setFormLoading(false);

        }

    }


    /* =====================================================
       DELETE / DEACTIVATE
    ===================================================== */

    async function deleteProduct(
        productId
    ) {

        const product =
            products.find(
                item =>
                    Number(item.id) ===
                    Number(productId)
            );


        if (!product) {
            return;
        }


        const confirmed =
            window.confirm(
                `Deactivate "${product.name}"?`
            );


        if (!confirmed) {
            return;
        }


        try {

            await API.deleteProduct(
                productId
            );


            showSuccess(
                "Product deactivated successfully."
            );


            await loadProducts();


        } catch (error) {

            console.error(
                "Product deactivation error:",
                error
            );


            showError(
                error.message ||
                "Unable to deactivate product."
            );

        }

    }


    /* =====================================================
       EDIT PRODUCT
    ===================================================== */

    function editProduct(
        productId
    ) {

        const product =
            products.find(
                item =>
                    Number(item.id) ===
                    Number(productId)
            );


        if (!product) {
            return;
        }


        const newPrice =
            window.prompt(
                `Update price for ${product.name}:`,
                product.price
            );


        if (newPrice === null) {
            return;
        }


        const price =
            Number(newPrice);


        if (!Number.isFinite(price) || price <= 0) {

            showError(
                "Enter a valid price."
            );

            return;

        }


        updateProductPrice(
            product.id,
            price,
            product
        );

    }


    async function updateProductPrice(
        productId,
        price,
        product
    ) {

        try {

            await API.updateProduct(
                productId,
                {

                    name:
                        product.name,

                    category:
                        product.category,

                    description:
                        product.description,

                    price,

                    unit:
                        product.unit,

                    quantity_posted:
                        product.quantity_posted

                }
            );


            showSuccess(
                "Product updated successfully."
            );


            await loadProducts();


        } catch (error) {

            console.error(
                "Update product error:",
                error
            );


            showError(
                error.message ||
                "Unable to update product."
            );

        }

    }


    /* =====================================================
       DUPLICATE
    ===================================================== */

    function duplicateProduct(
        productId
    ) {

        const product =
            products.find(
                item =>
                    Number(item.id) ===
                    Number(productId)
            );


        if (!product) {
            return;
        }


        openAddProduct();


        setValue(
            "productName",
            `${product.name} Copy`
        );


        setValue(
            "productCategory",
            product.category ||
            ""
        );


        setValue(
            "productPrice",
            product.price ||
            ""
        );


        setValue(
            "productUnit",
            product.unit ||
            "kg"
        );


        setValue(
            "productQuantity",
            product.quantity_remaining ||
            1
        );


        setValue(
            "productDescription",
            product.description ||
            ""
        );

    }


