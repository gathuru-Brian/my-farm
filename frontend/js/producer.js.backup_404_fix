                                                    ${id},
                                                    'accepted'
                                                )
                                            "
                                            style="
                                                background:#e5f5e8;
                                                color:#147238;
                                            "
                                        >
                                            Accept
                                        </button>

                                        <button
                                            onclick="
                                                changeOrderStatus(
                                                    ${id},
                                                    'rejected'
                                                )
                                            "
                                            style="
