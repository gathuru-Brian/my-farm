        );

    }


    function setFormLoading(
        loading
    ) {

        const form =
            document.getElementById(
                "addProductForm"
            );


        if (!form) {
            return;
        }


        const button =
            form.querySelector(
                "button[type='submit']"
            );


        if (!button) {
            return;
        }


        button.disabled =
            loading;


        button.textContent =
            loading
                ? "Adding..."
                : "Add Product";

    }


