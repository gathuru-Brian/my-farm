        const container =
            document.getElementById(
                "ordersManagement"
            );


        if (!container) {
            return;
        }


        if (!orders.length) {

            container.innerHTML = `

                <div class="dashboard-card">

                    <div class="empty-state">

                        <div class="empty-icon">
                            🛒
                        </div>

                        <h3>
                            No customer orders yet
                        </h3>

                        <p>
                            New customer orders will
                            appear here.
                        </p>

                    </div>

                </div>

            `;

            return;

        }


        container.innerHTML =
            orders.map(
                order => {

                    const id =
                        Number(order.id) || 0;


                    const status =
                        normalizeStatus(
                            order.status
                        );


                    return `

                        <div
                            class="order-row"
                        >

                            <div>

                                <div class="order-title">
                                    Order #${id}
                                </div>

                                <div
                                    class="order-meta"
                                >
                                    Quantity:
                                    ${Number(
                                        order.quantity ||
                                        order.quantity_ordered ||
                                        1
                                    )}
                                </div>

                            </div>


                            <span
                                class="order-status"
                            >
                                ${capitalize(
                                    status
                                )}
                            </span>


                            <strong>
                                ${formatCurrency(
                                    getOrderTotal(
                                        order
                                    )
                                )}
                            </strong>


                            <div
                                class="order-actions"
                            >

                                ${
                                    status === "pending"
